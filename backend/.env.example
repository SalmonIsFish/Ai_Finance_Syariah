# --- Alpaca (paper only; live trading is disabled by design) ---
# Create free paper keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_MODE=paper
# Optional: pin the market-data feed (sip/iex). Leave blank to auto-select.
ALPACA_DATA_FEED=
# Optional: override how the Alpaca MCP server is launched (needs `uv` installed).
ALPACA_MCP_COMMAND=uvx alpaca-mcp-server

# --- Market data provider: alpaca (default) or tiingo ---
MARKET_DATA_PROVIDER=alpaca
TIINGO_API_TOKEN=

# --- Shariah screening ---
# Sandbox returns RANDOMIZED placeholder data. Use live for real screening.
ZOYA_API_KEY=
ZOYA_ENVIRONMENT=sandbox

# SEC EDGAR requires a descriptive User-Agent identifying the requester; bare
# requests are blocked. Used by sec_edgar_screen.py. Format: name and contact.
SEC_EDGAR_USER_AGENT=

# Temporary on-disk cache for raw SEC responses (backend/sec_edgar_cache/), so a
# repeated screen of the same symbol does not re-download several MB. This is a
# shim, not the screening store in NEXT_STEPS.md -- see sec_edgar_cache.py.
# Entry lifetime in hours; 0 disables the cache entirely. Default 24.
SEC_EDGAR_CACHE_TTL_HOURS=
# Floor between live SEC fetches, in milliseconds. SEC's guidance is a maximum of
# 10 requests/second; the default 125 ms is roughly 8/s. Default 125.
SEC_EDGAR_MIN_REQUEST_INTERVAL_MS=

# Both default to the committed in-repo copies; override to use a private vault.
SHARIAH_UNIVERSE_PATH=
SHARIAH_WIKI_PATH=

TRADING_MODE=approval

# Origins allowed to call this API cross-origin, comma separated. Leave unset for
# local development -- the default covers a dashboard opened off disk (file:// sends
# the literal origin "null") and the usual local static servers. A deployment that
# serves the dashboard from its own origin should narrow this to just that origin,
# e.g. ALLOWED_ORIGINS=https://amanahtrader.uk
ALLOWED_ORIGINS=
MOOMOO_MODE=paper
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
PAPER_EXECUTION_ENABLED=false
# disabled | fake | alpaca | alpaca_mcp | moomoo (legacy)
PAPER_EXECUTION_ADAPTER=disabled
# Every risk cap below is a percentage OF THIS FIGURE, so a stale value silently
# mis-sizes all of them -- a 10000 here against a 100000 account caps a position
# at $500 instead of $4998, which reads as an inexplicable rejection rather than
# a config problem. `provision_cash_account.py` syncs it to the broker's real
# equity (dry-run by default, --apply to write), so run that after pointing the
# app at a different account.
PAPER_ACCOUNT_EQUITY=10000
MAX_POSITION_PCT=5.0
MAX_TOTAL_EXPOSURE_PCT=25.0
MAX_LOSS_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=1.0
MAX_ORDERS_PER_DAY=5

# --- OpenRouter (AI news summaries) ---
# Powers the News panel's plain-language article summaries. The model explains an
# article and restates the Shariah verdict this app has ALREADY computed
# deterministically -- it never screens, recommends, or advises. Leave the key
# blank and the panel still works: every article keeps Alpaca's own headline and
# summary, and the AI block simply does not render.
# Verify the model id and its current pricing at https://openrouter.ai/models
# before changing OPENROUTER_MODEL -- ids and prices there change without notice.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
NEWS_AI_SUMMARY_ENABLED=true
# Caps how many articles per /news response get an AI summary, so latency and
# spend stay bounded no matter how large the watchlist grows.
NEWS_AI_SUMMARY_MAX_ARTICLES=5
NEWS_AI_SUMMARY_CACHE_TTL_MINUTES=60

# --- Quant strategies ---
# Which deterministic entry strategies the quant agent runs, in priority order.
# S001 = uptrend making a new 55-day high (buys strength).
# S002 = pullback inside that same uptrend, holding SMA50 and turning back up.
# Both share the identical SMA50 > SMA200 trend filter, so S002 is a second
# trigger inside the same regime rather than a lower bar. Set QUANT_STRATEGIES=S001
# to restore single-strategy behaviour exactly.
QUANT_STRATEGIES=S001,S002

# --- Sector concentration ---
# Maximum share of paper account equity in any one sector, so a book can satisfy
# every per-position cap and still be five names in one industry. Sector comes
# from the SEC SIC code the Shariah screen already fetches -- no new data source.
# Symbols with no screen on record share one "Unclassified" bucket, capped the
# same way, so missing data cannot be used to hide concentration. Set to 0 to
# disable the check entirely.
# Chosen to sit between the two caps either side of it: comfortably above
# MAX_POSITION_PCT (5.0), so one full-size position can never trip it on its
# own, and below MAX_TOTAL_EXPOSURE_PCT (25.0), so it is a real constraint
# rather than decoration -- reaching full exposure needs at least two sectors.
MAX_SECTOR_EXPOSURE_PCT=20.0

# --- Database backups (backend/backup_database.py) ---
# Directory timestamped, checksummed backups of paper_trading.db are written
# into. Defaults to backups/paper_trading_db one level above the backend/
# checkout if unset. On the VPS this should point OUTSIDE the app checkout --
# see docs/deployment/VPS_RUNBOOK.md's Backups section.
PAPER_DB_BACKUP_DIR=
# How many of the newest backups to keep before pruning older ones. Default 90.
PAPER_DB_BACKUP_RETENTION=
